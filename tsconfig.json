{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@athanor/core": ["./packages/athanor-core/src"],
      "@athanor/extractor": ["./packages/athanor-extractor/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
