{
  "name": "@athanor/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "athanor": "./bin/athanor.mjs"
  },
  "scripts": {
    "athanor": "node bin/athanor.mjs",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src/",
    "dev": "tsx src/bin/athanor.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@athanor/clone-api": "workspace:*",
    "@athanor/core": "workspace:*",
    "@athanor/extractor": "workspace:*",
    "@athanor/interviewer": "workspace:*",
    "@athanor/mcp-server": "workspace:*",
    "@inquirer/prompts": "^8.3.2",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "inquirer": "^13.3.2",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
